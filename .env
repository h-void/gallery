# 启动请填写 gallery.yml；此文件保留高级参数和旧版 Compose 配置。
# Use gallery.yml to start; this file retains advanced and legacy Compose settings.
# 也可直接改 docker-compose.yml 的默认值；要用 YAML 默认值，注释这里的同名配置。
# Or edit YAML fallbacks; comment out matching values here to use them.
# Windows: GALLERY_MEDIA_DIR=D:\Pictures
# Linux:   GALLERY_MEDIA_DIR=/home/user/pictures

# 已预留 3 个媒体目录，一个目录填一行，不要用逗号或分号拼接多个路径。
# 只有 1 个目录：只填上面的 GALLERY_MEDIA_DIR，下面两行不用动。
# 有 2 个目录：去掉下面 DIR2 行开头的 #，改成第二个目录。
# 有 3 个目录：再去掉 DIR3 行开头的 #，改成第三个目录。
# Three ready-made slots, one per line. Do not join paths with commas/semicolons.
# Uncomment DIR2 for a second directory and DIR3 for a third; leave unused lines commented.
# GALLERY_MEDIA_DIR2=E:\Art
# GALLERY_MEDIA_DIR3=F:\Collections
# 超过 3 个：必须同时在 YML 的 volumes 添加对应挂载行，示例见 README。
# 只在这里加 DIR4 不会自动挂载目录。DIR5、DIR6……同理，无固定数量上限。
# More than 3: also add each mount to YAML volumes; .env alone cannot create mounts.
# GALLERY_MEDIA_DIR4=G:/More

# cpu 默认；gpu = Linux Intel 核显；cuda = NVIDIA（只选一个）
# cpu default; gpu = Linux Intel; cuda = NVIDIA (choose only one).
# 切换前 docker compose down，切换后 docker compose up -d
COMPOSE_PROFILES=cpu

# 可选：网页端口 / Optional web port
# GALLERY_PORT=8899

# Intel 核显专用：填设备所属组 GID，查询方法见 README
# Intel only: device group GIDs; see README.
# GALLERY_RENDER_GID=109
# GALLERY_VIDEO_GID=44

# 高级参数一般不用改 / Advanced settings, usually no changes needed
# CHARACTER_RECOGNITION_ENABLED=1
# CHARACTER_RECOGNITION_PROVIDER=auto
# CHARACTER_ALLOW_CPU_FALLBACK=1
# ONNXRUNTIME_AUTO_DOWNLOAD=1
# CHARACTER_MODEL_IDLE_TIMEOUT_SECONDS=600
# SCAN_INTERVAL=21600
# HASH_INTERVAL=30
# DB_BACKUP_INTERVAL=43200
# DB_BACKUP_RETENTION=8
